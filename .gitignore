# ==============================
# CHAIN55 — Global ignores
# ==============================

# OS and IDE files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.swo
*.suo
*.log
*.tmp
*.temp

# ==============================
# Environment and secrets
# ==============================

.env
.env.*
!.env.example
!.env.*.example
secrets/
**/secrets/
credentials/
**/credentials/
*.secret
*.secrets
*credentials*.json
*service-account*.json

# Private keys and certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore

# ==============================
# Temporary simulation artifacts
# ==============================

# Root-level temporary simulation files shown in Explorer
/temp_sim*
/temp_sim*/
# Temporary files with common simulation naming
**/temp_sim_*
**/temp_simulation_*

# ==============================
# Frontend (React / Node / Vite)
# ==============================

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# General Node artifacts
node_modules/
dist/
dist-ssr/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local frontend environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# ==============================
# Backend (Java / Spring Boot / Maven)
# ==============================

**/target/
**/build/
**/out/
**/bin/
**/.gradle/
**/log/
*.class
*.jar
*.war
*.ear
*.nar

# Keep Maven wrapper files if the project uses them
!.mvn/wrapper/maven-wrapper.jar

