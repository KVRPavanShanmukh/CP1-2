# Central API URL pointing to the deployed/shared CHAIN55 backend:
# If teammates are accessing the backend across a LAN or cloud:
# VITE_API_BASE_URL=http://192.168.1.100:8080/api
# Or when running locally:
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: override the SockJS/STOMP endpoint (defaults to the same host as the API,
# replacing /api with /ws-simulation).
# VITE_WS_URL=http://localhost:8080/ws-simulation
