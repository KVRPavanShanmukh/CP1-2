# ==============================================================================
# CHAIN55 - Shared Database & Backend Configuration
# ==============================================================================
# To allow all team members and friends across different computers to connect
# to the same shared central database, configure MONGODB_URI below.
#
# Option A: MongoDB Atlas (Recommended for shared multi-machine access)
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/simulation_db?retryWrites=true&w=majority
#
# Option B: Central Dedicated Server or Local Network IP
# MONGODB_URI=mongodb://192.168.1.100:27017/simulation_db
#
# Option C: Local Development (Default if MONGODB_URI is unset)
MONGODB_URI=mongodb://localhost:27017/simulation_db

# RabbitMQ configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Backend server port
PORT=8080
