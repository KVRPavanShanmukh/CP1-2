# ==============================================================================
# CHAIN55 - Shared Database & Backend Configuration
# ==============================================================================
# To allow all team members and friends across different computers to connect
# to the same shared central database, configure MONGODB_URI below.
#
# Option A: MongoDB Atlas (Recommended for shared multi-machine access)
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/simulation_db?retryWrites=true&w=majority
#
# Option B: Central Dedicated Server or Local Network IP
# MONGODB_URI=mongodb://192.168.1.100:27017/simulation_db
#
# Option C: Local Development (Default if MONGODB_URI is unset)
MONGODB_URI=mongodb://localhost:27017/simulation_db

# RabbitMQ configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Default vhost; set this to isolate several deployments sharing one broker.
RABBITMQ_VIRTUAL_HOST=/

# Backend server port
PORT=8080

# Session cookie: "lax" for local/LAN HTTP; use "none" + SESSION_COOKIE_SECURE=true on HTTPS.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Comma-separated frontend origins allowed by CORS and the STOMP endpoint.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Directory containing exp1-exp6 JSON datasets served by /api/simulations/research.
# Leave empty to auto-detect docs/research-results relative to the working directory.
RESEARCH_RESULTS_DIR=
