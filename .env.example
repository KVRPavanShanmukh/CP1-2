# ==============================================================================
# CHAIN55 - Shared Database & System Configuration
# ==============================================================================
# To allow all team members across different computers to register and see each
# other in the user directory, ALL users must connect to the SAME backend and
# the backend must connect to the SAME shared MongoDB database.
#
# ── MONGODB (Backend side only — NEVER expose credentials to the frontend) ──
#
# Option A: MongoDB Atlas (Recommended for multi-machine internet access)
# MONGODB_URI=mongodb+srv://<db_user>:<db_pass>@<cluster>.mongodb.net/simulation_db?retryWrites=true&w=majority
#
# Option B: Local network (replace with your server's LAN IP)
# MONGODB_URI=mongodb://192.168.1.100:27017/simulation_db
#
# Option C: Local development only
MONGODB_URI=mongodb://localhost:27017/simulation_db

# ── RABBITMQ ──
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── BACKEND PORT ──
PORT=8080

# ── SESSION COOKIE ──
# Set to true only when serving over HTTPS (production).
SESSION_COOKIE_SECURE=false

# ── CORS ──
# Comma-separated list of frontend origins allowed to make authenticated requests.
# Add any origin your teammates' browsers will use.
# Example: CORS_ALLOWED_ORIGINS=http://192.168.1.50:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
