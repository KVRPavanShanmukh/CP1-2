# ==============================================================================
# CHAIN55 - Shared Database & System Configuration
# ==============================================================================
# Central Persistent MongoDB URI (shared by all teammates across different computers):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/simulation_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/simulation_db

# Message broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Backend port
PORT=8080

# Frontend API base URL (set this in frontend/.env to point to backend server):
# VITE_API_BASE_URL=http://<backend_ip_or_domain>:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
